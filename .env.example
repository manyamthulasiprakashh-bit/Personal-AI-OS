AGENT_PLANNER_MAX_OUTPUT_TOKENS=512
AGENT_PLANNER_LOCAL_BASE_URL="http://localhost:11434"
AGENT_PLANNER_LOCAL_TIMEOUT_SECONDS=30
ALPHAVANTAGE_API_KEY=""
ALPHAVANTAGE_API_BASE_URL="https://www.alphavantage.co/query"
STOCK_TIMEOUT_SECONDS=10
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1000
JOB_ANALYSIS_MAX_INPUT_CHARS=20000

# Security
SECRET_KEY="replace-with-a-secure-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000"

# AI providers (reserved for future)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
