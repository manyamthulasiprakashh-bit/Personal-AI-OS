# App
PROJECT_NAME="Personal AI-OS"
ENVIRONMENT="development"
API_V1_STR="/api"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL="INFO"

# Database
DATABASE_URL="postgresql+psycopg://personal_ai_os:personal_ai_os@localhost:5432/personal_ai_os"
POSTGRES_DB="personal_ai_os"
POSTGRES_USER="personal_ai_os"
POSTGRES_PASSWORD="personal_ai_os"
DEVELOPMENT_USER_EMAIL=""

# Security
SECRET_KEY="replace-with-a-secure-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000"

# AI providers (reserved for future)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
