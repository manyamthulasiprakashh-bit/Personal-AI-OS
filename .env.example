# App
PROJECT_NAME="Personal AI-OS"
ENVIRONMENT="development"
API_V1_STR="/api"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL="INFO"

# Database
DATABASE_URL="postgresql+psycopg://personal_ai_os:personal_ai_os@localhost:5432/personal_ai_os"
POSTGRES_DB="personal_ai_os"
POSTGRES_USER="personal_ai_os"
POSTGRES_PASSWORD="personal_ai_os"
DEVELOPMENT_USER_EMAIL=""
AUTH_MODE="development"
AUTH0_ISSUER=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_AUDIENCE=""
AUTH0_REDIRECT_URI="http://localhost:8000/auth/callback"
AUTH_FRONTEND_REDIRECT_URI="http://localhost:3000"
AUTH_SESSION_COOKIE_NAME="personal_ai_os_session"
AUTH_STATE_COOKIE_NAME="personal_ai_os_auth_state"
AUTH_SESSION_TTL_SECONDS=28800
AUTH_STATE_TTL_SECONDS=600
JOB_PROVIDER="mock"
STOCK_PROVIDER="mock"
AGENT_PLANNER_PROVIDER="rule_based"
AGENT_PLANNER_MODEL=""
